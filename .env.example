# SENTINEL configuration. Copy to .env and edit. Never commit .env.
# The SEC requires a declared contact address in the User-Agent.
SENTINEL_CONTACT_EMAIL=you@example.com
SENTINEL_USER_AGENT=sentinel-research/0.1
# Optional: only needed for the email notifier
SENTINEL_SMTP_HOST=
SENTINEL_SMTP_PORT=465
SENTINEL_SMTP_USER=
SENTINEL_SMTP_PASSWORD=
